// Prisma schema - Supabase (Postgres) como banco principal.
// Isolamento multi-tenant continua sendo por tenantId filtrado em cada service.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  medico
  assistente
}

enum ConsultationStatus {
  rascunho
  em_atendimento
  pausada
  finalizada
}

enum QueueStatus {
  aguardando
  em_atendimento
  pausado
  atendido
  faltou
}

enum ExamStatus {
  solicitado
  em_andamento
  disponivel
  entregue
}

model Doctor {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String
  nome          String
  email         String?
  telefone      String?
  especialidade String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  appointments  Appointment[]
  consultations Consultation[]
  queueTickets  QueueTicket[]
  certificates  Certificate[]
  referrals     Referral[]

  @@index([tenantId])
  @@map("doctors")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String
  nome         String
  email        String   @unique
  passwordHash String
  role         Role     @default(admin)
  doctorId     String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("users")
}

model Patient {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String
  nome         String
  especie      String? // sempre "Humano"
  documento    String? // CPF
  contato      String?
  dataNasc     DateTime?
  alergias     String?
  observacoes  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  consultations Consultation[]
  prescriptions Prescription[]
  appointments  Appointment[]
  queueTickets  QueueTicket[]
  examRequests  ExamRequest[]
  certificates  Certificate[]
  referrals     Referral[]

  @@index([tenantId])
  @@index([tenantId, nome])
  @@index([tenantId, documento])
  @@map("patients")
}

model Appointment {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String
  patientId String    @db.Uuid
  doctorId  String    @db.Uuid
  data_hora DateTime?
  status    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([doctorId])
  @@index([patientId])
  @@index([tenantId, data_hora])
  @@map("appointments")
}

model Consultation {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String
  patientId    String             @db.Uuid
  doctorId     String             @db.Uuid
  queixa       String?
  conduta      String?
  cid          String?
  status       ConsultationStatus @default(em_atendimento)
  iniciadaEm   DateTime           @default(now())
  finalizadaEm DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  prescriptions Prescription[]
  examRequests  ExamRequest[]
  certificates  Certificate[]
  referrals     Referral[]
  queueTickets  QueueTicket[]

  @@index([tenantId])
  @@index([doctorId])
  @@index([patientId])
  @@index([tenantId, doctorId, status])
  @@map("consultations")
}

model Prescription {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String
  patientId      String    @db.Uuid
  consultationId String?   @db.Uuid
  medicamento    String
  dose           String?
  posologia      String?
  duracao        String?
  usoContinuo    Boolean   @default(false)
  iniciadaEm     DateTime  @default(now())
  encerradaEm    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([patientId])
  @@index([consultationId])
  @@map("prescriptions")
}

model ExamRequest {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String
  patientId      String     @db.Uuid
  consultationId String?    @db.Uuid
  tipo           String
  justificativa  String?
  status         ExamStatus @default(solicitado)
  resultado      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([patientId])
  @@index([consultationId])
  @@map("exam_requests")
}

model Certificate {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String
  patientId      String   @db.Uuid
  consultationId String?  @db.Uuid
  doctorId       String   @db.Uuid
  dias           Int
  cid            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@map("certificates")
}

model Referral {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String
  patientId      String   @db.Uuid
  consultationId String?  @db.Uuid
  doctorId       String   @db.Uuid
  destino        String
  motivo         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([patientId])
  @@map("referrals")
}

model QueueTicket {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String
  patientId      String      @db.Uuid
  doctorId       String?     @db.Uuid
  consultationId String?     @db.Uuid
  setor          String?
  status         QueueStatus @default(aguardando)
  position       Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([patientId])
  @@index([tenantId, status, position])
  @@map("queue_tickets")
}
