PORT=3000

# MongoDB (use credenciais fortes e unicas - nunca commitar o .env real)
MONGO_URI=mongodb://localhost:27017/saas_hospitalar

# Segredo usado para assinar os JWTs de autenticacao.
# Gere um valor aleatorio forte, ex: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origens do frontend autorizadas a chamar a API (separadas por virgula).
CORS_ORIGIN=http://localhost:5173
